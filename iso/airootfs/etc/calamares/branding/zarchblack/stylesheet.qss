/* Calamares Stylesheet - ZarchBlack Neon Theme */

/* Main window background and default text */
#mainApp {
    background-color: #0d0914;
    color: #ffffff;
    font-family: "Noto Sans", sans-serif;
    font-size: 13px;
}

/* Sidebar styling */
#sidebarApp {
    background-color: #0c0813;
    border-right: 1px solid #1a162b;
}

/* Sidebar Logo */
#logoApp {
    background-color: transparent;
    padding: 10px;
}

/* Individual Pages/Views */
QWidget {
    background-color: #0d0914;
    color: #ffffff;
}

/* Navigation bar */
#navigationApp {
    background-color: #0c0813;
    border-top: 1px solid #1a162b;
}

/* Push Buttons (Next, Back, Cancel, etc.) */
QPushButton {
    background-color: #1a102f;
    border: 1px solid #d200ff;
    border-radius: 4px;
    padding: 6px 16px;
    color: #ffffff;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #00ffff;
    border: 1px solid #00ffff;
    color: #0d0914;
}

QPushButton:pressed {
    background-color: #00cccc;
    border: 1px solid #00cccc;
    color: #0d0914;
}

QPushButton:disabled {
    background-color: #15121c;
    border: 1px solid #2d2642;
    color: #71717a;
}

/* Text Inputs / LineEdits */
QLineEdit, QComboBox, QSpinBox {
    background-color: #1a1630;
    border: 1px solid #d200ff;
    border-radius: 4px;
    padding: 5px;
    color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #00ffff;
}

/* Progress bar styling */
QProgressBar {
    background-color: #1a1630;
    border: 1px solid #d200ff;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d200ff, stop:1 #00ffff);
    border-radius: 3px;
}

/* Table View and Partition Bar (Very important for installation visual feedback) */
QHeaderView::section {
    background-color: #1c1836;
    color: #ffffff;
    border: 1px solid #2d2642;
    padding: 4px;
}

QTreeView, QListView, QTableView {
    background-color: #120e24;
    border: 1px solid #2d2642;
    color: #ffffff;
    gridline-color: #2d2642;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #d200ff;
    color: #ffffff;
}

/* Labels and Headers */
QLabel {
    color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #0d0914;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d200ff;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00ffff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0d0914;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d200ff;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00ffff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
