# ============================================================
# ZarchBlack ISO — .gitignore
# ============================================================

# archiso build artifacts (generated automatically, never commit)
work/
out/
*.iso
*.img

# local pacman repository (binaries rebuilt on demand)
local-repo/repo/*.pkg.tar.zst
local-repo/repo/*.pkg.tar.zst.old
local-repo/repo/*.db
local-repo/repo/*.db.tar.gz
local-repo/repo/*.db.tar.gz.old
local-repo/repo/*.files
local-repo/repo/*.files.tar.gz
local-repo/repo/*.files.tar.gz.old
local-repo/db/
local-repo/staging/
local-repo/testing/

# icon themes (downloaded externally, not source code)
themes/icons/Magna-Dark-Icons/
themes/icons/Magna-Glassy-Dark-Icons/
themes/icons/Reversal-purple/
themes/icons/Reversal-purple-dark/
themes/icons/Tela-circle-dracula/
themes/icons/Tela-circle-dracula-dark/
themes/icons/Tela-circle-dracula-light/
themes/icons/Varied-kde-arch/
themes/icons/Varied-kde-arch-dark/
themes/icons/Varied-kde-arch-light/
themes/icons/Gradient-KDE-Story-Blue-Dark-Icons/

# editor and system junk
*.swp
*.swo
*~
*.bak
.DS_Store
Thumbs.db

# python cache
__pycache__/
*.pyc
*.pyo

# logs
*.log
logs/

# secrets (never commit)
*.pem
*.key
id_rsa
id_ed25519
*secret*
*token*

# airootfs — system cache and package data (auto-generated)
kde-releng/airootfs/var/cache/
kde-releng/airootfs/var/lib/flatpak/

# airootfs — installed system binaries and libraries (auto-generated by mkarchiso)
kde-releng/airootfs/usr/lib/
kde-releng/airootfs/usr/bin/
kde-releng/airootfs/var/

# airootfs icons — external icon themes duplicated from themes/icons/
kde-releng/airootfs/usr/share/icons/Magna-Dark-Icons/
kde-releng/airootfs/usr/share/icons/Magna-Glassy-Dark-Icons/
kde-releng/airootfs/usr/share/icons/Reversal-purple/
kde-releng/airootfs/usr/share/icons/Reversal-purple-dark/
kde-releng/airootfs/usr/share/icons/Tela-circle-dracula/
kde-releng/airootfs/usr/share/icons/Tela-circle-dracula-dark/
kde-releng/airootfs/usr/share/icons/Tela-circle-dracula-light/
kde-releng/airootfs/usr/share/icons/Tela-circle-icon-theme-master/
kde-releng/airootfs/usr/share/icons/Varied-kde-arch/
kde-releng/airootfs/usr/share/icons/Varied-kde-arch-dark/
kde-releng/airootfs/usr/share/icons/Varied-kde-arch-light/
kde-releng/airootfs/usr/share/icons/Gradient-KDE-Story-Blue-Dark-Icons/
kde-releng/airootfs/usr/share/icons/hicolor/
kde-releng/airootfs/usr/share/icons/default/
