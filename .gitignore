# ============================================================
# ZarchBlack ISO — .gitignore
# ============================================================

# archiso build artifacts (generated automatically, never commit)
work/
out/
*.iso
*.img

# build and repo output directories (never commit binaries here)
build/
repo/
x86_64/

# icon themes (downloaded externally, not source code)
themes/icons/Magna-Dark-Icons/
themes/icons/Magna-Glassy-Dark-Icons/
themes/icons/Reversal-purple/
themes/icons/Reversal-purple-dark/
themes/icons/Tela-circle-dracula/
themes/icons/Tela-circle-dracula-dark/
themes/icons/Tela-circle-dracula-light/
themes/icons/Varied-kde-arch/
themes/icons/Varied-kde-arch-dark/
themes/icons/Varied-kde-arch-light/
themes/icons/Gradient-KDE-Story-Blue-Dark-Icons/

# editor and system junk
*.swp
*.swo
*~
*.bak
.DS_Store
Thumbs.db

# python cache
__pycache__/
*.pyc
*.pyo

# logs
*.log
logs/

# secrets (never commit)
*.pem
*.key
id_rsa
id_ed25519
*secret*
*token*

# airootfs — system cache and package data (auto-generated)
iso/airootfs/var/cache/
iso/airootfs/var/lib/flatpak/

# airootfs — installed system binaries and libraries (auto-generated by mkarchiso)
iso/airootfs/usr/lib/
iso/airootfs/usr/bin/
iso/airootfs/var/

# Welcome Center source — tracked in git (ZarchBlack custom app)
!iso/airootfs/usr/lib/zarchblack-welcome/
!iso/airootfs/usr/lib/zarchblack-welcome/**
!iso/airootfs/usr/bin/zarchblack-welcome
!iso/airootfs/usr/share/applications/zarchblack-welcome.desktop
!iso/airootfs/usr/share/icons/hicolor/256x256/apps/zarchblack-welcome.png

# airootfs icons — external icon themes duplicated from themes/icons/
iso/airootfs/usr/share/icons/Magna-Dark-Icons/
iso/airootfs/usr/share/icons/Magna-Glassy-Dark-Icons/
iso/airootfs/usr/share/icons/Reversal-purple/
iso/airootfs/usr/share/icons/Reversal-purple-dark/
iso/airootfs/usr/share/icons/Tela-circle-dracula/
iso/airootfs/usr/share/icons/Tela-circle-dracula-dark/
iso/airootfs/usr/share/icons/Tela-circle-dracula-light/
iso/airootfs/usr/share/icons/Tela-circle-icon-theme-master/
iso/airootfs/usr/share/icons/Varied-kde-arch/
iso/airootfs/usr/share/icons/Varied-kde-arch-dark/
iso/airootfs/usr/share/icons/Varied-kde-arch-light/
iso/airootfs/usr/share/icons/Gradient-KDE-Story-Blue-Dark-Icons/
iso/airootfs/usr/share/icons/hicolor/
iso/airootfs/usr/share/icons/default/
*.AppImage
*.pkg.tar.*
src/
pkg/

# Package build artifacts
packages/*/pkg/
packages/*/src/
