# Maintainer: ZarchBlack <https://github.com/ZarchBlack>
# ZarchBlack SDDM Theme - Login screen branding

pkgname=zarchblack-sddm-theme
pkgver=1.0.0
pkgrel=1
pkgdesc="ZarchBlack SDDM login theme - ZeroDark SDDM theme"
arch=('any')
url="https://github.com/ZarchBlack/zarchblack"
license=('GPL3')
depends=('sddm')
install=zarchblack-sddm-theme.install
source=()
sha256sums=()

package() {
  # Copy ZeroDark SDDM theme from staged directory
  mkdir -p "${pkgdir}/usr/share/sddm/themes/ZeroDark"
  if [ -d "${startdir}/ZeroDark" ]; then
    cp -r "${startdir}/ZeroDark/." "${pkgdir}/usr/share/sddm/themes/ZeroDark/"
  else
    # Fallback to absolute path
    cp -r /home/zarch/zarchblack_iso/iso/airootfs/usr/share/sddm/themes/ZeroDark/. "${pkgdir}/usr/share/sddm/themes/ZeroDark/"
  fi
  
  mkdir -p "${pkgdir}/usr/share/doc/zarchblack-sddm-theme"
  echo "ZarchBlack SDDM Theme ${pkgver}" > "${pkgdir}/usr/share/doc/zarchblack-sddm-theme/README"
}
