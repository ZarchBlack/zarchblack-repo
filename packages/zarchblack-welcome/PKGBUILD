#CloseBtn {
    background: transparent; color: #475569;
    border: 1px solid #2a2a45; border-radius: 8px; font-size: 13px; padding: 8px 24px;
}
#CloseBtn:hover { background: #12121e; color: #e2e8f0; border-color: #475569; }
