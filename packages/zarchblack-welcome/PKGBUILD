# Maintainer: ZarchBlack <https://github.com/ZarchBlack>
# ZarchBlack Welcome Center - First-run welcome screen

pkgname=zarchblack-welcome
pkgver=2.0.0
pkgrel=1
pkgdesc="ZarchBlack Welcome Center - First-run welcome screen with installer and tool launcher"
arch=('any')
url="https://zarchblack.pages.dev"
license=('GPL3')
depends=('python' 'python-pyqt6')
install=zarchblack-welcome.install
source=()
sha256sums=()

package() {
  # ── Directories ──────────────────────────────────────────────────────────
  install -dm755 "${pkgdir}/usr/bin"
  install -dm755 "${pkgdir}/usr/lib/zarchblack-welcome/assets"
  install -dm755 "${pkgdir}/usr/share/applications"
  install -dm755 "${pkgdir}/usr/share/icons/hicolor/256x256/apps"
  install -dm755 "${pkgdir}/usr/share/icons/hicolor/128x128/apps"
  install -dm755 "${pkgdir}/usr/share/icons/hicolor/64x64/apps"

  # ── Launcher (executable) ─────────────────────────────────────────────────
  cat > "${pkgdir}/usr/bin/zarchblack-welcome" << 'BINEOF'
#!/usr/bin/env bash
exec python3 /usr/lib/zarchblack-welcome/main.py "$@"
BINEOF
  chmod 755 "${pkgdir}/usr/bin/zarchblack-welcome"

  # ── Main Python application ───────────────────────────────────────────────
  cat > "${pkgdir}/usr/lib/zarchblack-welcome/main.py" << 'PYEOF'
#!/usr/bin/env python3
"""
ZarchBlack Welcome Center v2.0
© 2026 ZarchBlack Project — https://zarchblack.pages.dev
"""

