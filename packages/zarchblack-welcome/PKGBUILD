class LaunchThread(QThread):
    error_signal = pyqtSignal(str)
    def __init__(self, cmd):
        super().__init__()
        self.cmd = cmd
    def run(self):
        try:
            subprocess.Popen(self.cmd, shell=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            self.error_signal.emit(str(e))


class FeatureCard(QFrame):
    def __init__(self, icon, title, desc, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(90)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Minimum)
        self.setStyleSheet("""
            QFrame { background:#12121e; border:1px solid #1a1a2e; border-radius:14px; }
            QFrame:hover { border-color:#3a2a65; background:#16162a; }
        """)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 14, 16, 14)
        lay.setSpacing(14)

        ic = QLabel(icon)
        ic.setFont(QFont("Noto Color Emoji", 22))
        ic.setFixedWidth(36)
        ic.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(ic)

        vl = QVBoxLayout(); vl.setSpacing(4)
        t = QLabel(title)
        t.setStyleSheet("color:#e2e8f0;font-weight:700;font-size:13px;background:transparent;border:none;")
        vl.addWidget(t)
        d = QLabel(desc)
        d.setStyleSheet("color:#94a3b8;font-size:11px;background:transparent;border:none;")
        d.setWordWrap(True)
        vl.addWidget(d)
        lay.addLayout(vl)


class WelcomeWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Welcome to ZarchBlack")
        self._threads = []
        if LOGO_PATH.exists():
            self.setWindowIcon(QIcon(str(LOGO_PATH)))

        # Responsive sizing: 75% of screen, min 900x680, max 1200x900
        screen = QApplication.primaryScreen().geometry()
        w = max(900, min(1100, int(screen.width() * 0.72)))
        h = max(700, min(900, int(screen.height() * 0.80)))
        self.resize(w, h)
        self.setMinimumSize(860, 660)

        self._build_ui()
        self._center()

    def _build_ui(self):
        root = QWidget()
        self.setCentralWidget(root)
        outer = QVBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        outer.addWidget(scroll)

        c = QWidget(); scroll.setWidget(c)
        ml = QVBoxLayout(c)
        ml.setContentsMargins(52, 40, 52, 36)
        ml.setSpacing(0)

        ml.addLayout(self._header());           ml.addSpacing(28)
        ml.addWidget(self._divider());          ml.addSpacing(24)
        ml.addWidget(self._welcome_text());     ml.addSpacing(28)
        ml.addWidget(self._sec("✨  Features")); ml.addSpacing(12)
        ml.addLayout(self._features());         ml.addSpacing(32)
        ml.addWidget(self._divider());          ml.addSpacing(24)
        ml.addWidget(self._install_section());  ml.addSpacing(32)
        ml.addWidget(self._sec("🛠  ZarchBlack Tools")); ml.addSpacing(12)
        ml.addLayout(self._apps());             ml.addSpacing(32)
        ml.addWidget(self._divider());          ml.addSpacing(20)
        ml.addWidget(self._sec("🌐  Community & Links")); ml.addSpacing(12)
        ml.addLayout(self._social());           ml.addSpacing(30)
        ml.addStretch()
        ml.addLayout(self._bottom())

    def _header(self):
        lay = QHBoxLayout(); lay.setSpacing(20)
        lbl = QLabel()
        if LOGO_PATH.exists():
            px = QPixmap(str(LOGO_PATH)).scaled(
                96, 96, Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation)
            lbl.setPixmap(px)
        lbl.setFixedSize(96, 96)
        lay.addWidget(lbl, alignment=Qt.AlignmentFlag.AlignVCenter)

        vl = QVBoxLayout(); vl.setSpacing(6)
        t = QLabel("ZarchBlack")
        t.setStyleSheet("font-size:44px;font-weight:800;color:#b060ff;background:transparent;letter-spacing:1px;")
        vl.addWidget(t)
        s = QLabel("A modern Arch Linux-based distribution for professionals")
        s.setStyleSheet("font-size:13px;color:#94a3b8;background:transparent;")
        vl.addWidget(s)
        v = QLabel("Version 2026.07.07  •  Kernel: linux-zen  •  KDE Plasma 6 on Wayland  •  Developed by Zero7x")
        v.setStyleSheet("font-size:11px;color:#475569;background:transparent;")
        vl.addWidget(v)
        lay.addLayout(vl); lay.addStretch()
        return lay

    def _welcome_text(self):
        lbl = QLabel(
            "Welcome to <span style='color:#b060ff;font-weight:700;'>ZarchBlack Linux</span>!<br><br>"
            "ZarchBlack is a <b>rolling-release</b> distribution built on <b>Arch Linux</b>, "
            "designed for developers, cybersecurity professionals, ethical hackers, and "
            "system administrators.<br><br>"
            "It ships with <b>KDE Plasma 6</b> on <b>Wayland</b>, pre-configured with the "
            "<b>Catppuccin Mocha Lavender</b> theme, <b>linux-zen</b> kernel for maximum "
            "performance, and a full suite of security and development tools ready out of the box."
        )
        lbl.setWordWrap(True)
        lbl.setTextFormat(Qt.TextFormat.RichText)
        lbl.setStyleSheet(
            "font-size:13px;color:#cbd5e1;background-color:#12121e;"
            "border:1px solid #1a1a2e;border-radius:14px;padding:20px 26px;"
        )
        return lbl

    def _features(self):
        items = [
            ("🖥", "KDE Plasma 6",       "Wayland-native with Catppuccin Mocha Lavender theme"),
            ("🔒", "Cybersecurity Suite", "BlackArch repo + zarch-hacking + firejail + firewalld"),
            ("⚡", "linux-zen Kernel",    "Optimized for responsiveness and low latency"),
            ("📦", "Smart Packaging",     "Pacman + Chaotic-AUR + Flatpak + zpackagemanager"),
            ("🎨", "Full Customization",  "Darkly / Kvantum / Layan Decorations / Custom Icons"),
            ("🌐", "Wayland Native",      "Default Wayland session with full app compatibility"),
        ]
        gl = QVBoxLayout(); gl.setSpacing(10)
        r1 = QHBoxLayout(); r1.setSpacing(10)
        r2 = QHBoxLayout(); r2.setSpacing(10)
        for i, (ic, t, d) in enumerate(items):
            (r1 if i < 3 else r2).addWidget(FeatureCard(ic, t, d))
        gl.addLayout(r1); gl.addLayout(r2)
        return gl

    def _install_section(self):
        f = QFrame()
        f.setStyleSheet("""
            QFrame { background:qlineargradient(x1:0,y1:0,x2:1,y2:1,
                         stop:0 #0f0f1e, stop:0.5 #13102e, stop:1 #0f0f1e);
                     border:1px solid #2a2a55; border-radius:18px; }
        """)
        lay = QVBoxLayout(f); lay.setContentsMargins(36, 26, 36, 26); lay.setSpacing(12)

        t = QLabel("🚀  Install ZarchBlack")
        t.setStyleSheet("font-size:18px;font-weight:700;color:#e2e8f0;background:transparent;")
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(t)

        d = QLabel("Click the button below to install ZarchBlack on your hard drive using the Calamares installer.")
        d.setWordWrap(True)
        d.setAlignment(Qt.AlignmentFlag.AlignCenter)
        d.setStyleSheet("font-size:13px;color:#94a3b8;background:transparent;")
        lay.addWidget(d)
        lay.addSpacing(8)

        row = QHBoxLayout(); row.setAlignment(Qt.AlignmentFlag.AlignCenter)
        btn = QPushButton("  🖥  Install ZarchBlack")
        btn.setObjectName("InstallBtn")
        btn.setFixedHeight(54)
        btn.setMinimumWidth(280)
        btn.setCursor(Qt.CursorShape.PointingHandCursor)
        btn.clicked.connect(self._calamares)
        row.addWidget(btn)
        lay.addLayout(row)
        return f

    def _apps(self):
        items = [
            ("📦", "ZPackageManager",  "GUI package management\nfor Arch Linux",           "zpackagemanager"),
            ("🔓", "Zarch-Hacking",    "BlackArch tools manager\nfor penetration testing",  "zarch-hacking"),
            ("🛡", "ZArchGuard",       "System protection\nand security monitoring",        "zarchguard"),
            ("💻", "OpenCode Desktop", "AI-powered development\nenvironment",               "opencode-desktop"),
        ]
        lay = QHBoxLayout(); lay.setSpacing(12)
        for ic, nm, ds, cmd in items:
            b = QPushButton(f"{ic}\n{nm}\n{ds}")
            b.setObjectName("AppBtn"); b.setMinimumHeight(110)
            b.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.clicked.connect(lambda _, c=cmd: self._launch(c))
            lay.addWidget(b)
        return lay

    def _social(self):
        links = [
            ("🌐  Website",  "https://zarchblack.pages.dev/"),
            ("  GitHub",    "https://github.com/ZarchBlack/zarchblack-repo"),
            ("  Telegram",  "https://t.me/zarchblack"),
        ]
        lay = QHBoxLayout(); lay.setSpacing(12)
        lay.setAlignment(Qt.AlignmentFlag.AlignCenter)
        for i, (label, url) in enumerate(links):
            b = QPushButton(label)
            b.setObjectName("WebsiteBtn" if i == 0 else "SocialBtn")
            b.setFixedHeight(44)
            b.setMinimumWidth(140)
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.clicked.connect(lambda _, u=url: subprocess.Popen(
                ["xdg-open", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            lay.addWidget(b)
        return lay

    def _bottom(self):
        lay = QHBoxLayout()
        self.cb = QCheckBox("Show this window on startup")
        self.cb.setChecked(AUTOSTART_FILE.exists())
        self.cb.stateChanged.connect(self._toggle_autostart)
        lay.addWidget(self.cb); lay.addStretch()
        cb = QPushButton("Close"); cb.setObjectName("CloseBtn")
        cb.setFixedSize(100, 36); cb.setCursor(Qt.CursorShape.PointingHandCursor)
        cb.clicked.connect(self.close); lay.addWidget(cb)
        return lay

    def _divider(self):
        d = QFrame(); d.setObjectName("Divider")
        d.setFrameShape(QFrame.Shape.HLine); return d

    def _sec(self, text):
        l = QLabel(text)
        l.setStyleSheet("font-size:14px;font-weight:700;color:#b060ff;background:transparent;")
        return l

    def _center(self):
        g = QApplication.primaryScreen().geometry()
        self.move((g.width() - self.width()) // 2, (g.height() - self.height()) // 2)

    def _calamares(self):
        t = LaunchThread("pkexec calamares 2>/dev/null || sudo calamares 2>/dev/null || calamares")
        self._threads.append(t); t.start()

    def _launch(self, cmd):
        t = LaunchThread(cmd)
        self._threads.append(t); t.start()

    def _toggle_autostart(self, state):
        if state == 2:
            AUTOSTART_FILE.parent.mkdir(parents=True, exist_ok=True)
            AUTOSTART_FILE.write_text(AUTOSTART_CONTENT)
        elif AUTOSTART_FILE.exists():
            AUTOSTART_FILE.unlink()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("ZarchBlack Welcome")
    app.setOrganizationName("ZarchBlack")
    app.setDesktopFileName("zarchblack-welcome")
    app.setStyleSheet(THEME)
    QFontDatabase.addApplicationFont("/usr/share/fonts/inter/Inter-Regular.otf")
    QFontDatabase.addApplicationFont("/usr/share/fonts/inter/Inter-Bold.otf")
    win = WelcomeWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
PYEOF
  chmod 644 "${pkgdir}/usr/lib/zarchblack-welcome/main.py"

  # ── Desktop entry ─────────────────────────────────────────────────────────
  cat > "${pkgdir}/usr/share/applications/zarchblack-welcome.desktop" << 'DEOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=ZarchBlack Welcome Center
GenericName=Welcome Screen
Comment=Welcome to ZarchBlack Linux
Exec=zarchblack-welcome
Icon=zarchblack-welcome
Terminal=false
Categories=System;
Keywords=welcome;zarchblack;install;
StartupNotify=false
DEOF
  chmod 644 "${pkgdir}/usr/share/applications/zarchblack-welcome.desktop"

  # ── Icons (copy from calamares branding) ──────────────────────────────────
  local logo_src="/etc/calamares/branding/zarchblack/logo.png"
  if [[ -f "${logo_src}" ]]; then
    install -Dm644 "${logo_src}" "${pkgdir}/usr/lib/zarchblack-welcome/assets/logo.png"
    install -Dm644 "${logo_src}" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/zarchblack-welcome.png"
    install -Dm644 "${logo_src}" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/zarchblack-welcome.png"
    install -Dm644 "${logo_src}" "${pkgdir}/usr/share/icons/hicolor/64x64/apps/zarchblack-welcome.png"
  fi
}
