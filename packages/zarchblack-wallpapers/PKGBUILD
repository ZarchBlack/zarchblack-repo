# Maintainer: ZarchBlack <https://github.com/ZarchBlack>
# ZarchBlack Wallpapers - Official wallpaper collection

pkgname=zarchblack-wallpapers
pkgver=1.0.0
pkgrel=2
pkgdesc="ZarchBlack official wallpaper collection - curated high-quality backgrounds"
arch=('any')
url="https://github.com/ZarchBlack/zarchblack"
license=('GPL3')
install=zarchblack-wallpapers.install
source=()
sha256sums=()

package() {
  # Copy wallpapers from staged wallpapers directory
  mkdir -p "${pkgdir}/usr/share/wallpapers"
  if [ -d "${startdir}/wallpapers" ]; then
    cp -r "${startdir}/wallpapers/." "${pkgdir}/usr/share/wallpapers/"
  else
    # Fallback to absolute path
    cp -r /home/zarch/zarchblack_iso/iso/airootfs/usr/share/wallpapers/. "${pkgdir}/usr/share/wallpapers/"
  fi
  
  mkdir -p "${pkgdir}/usr/share/doc/zarchblack-wallpapers"
  echo "ZarchBlack Wallpapers ${pkgver}" > "${pkgdir}/usr/share/doc/zarchblack-wallpapers/README"
}
