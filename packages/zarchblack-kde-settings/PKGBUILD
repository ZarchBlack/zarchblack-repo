# Maintainer: ZarchBlack <https://github.com/ZarchBlack>
# ZarchBlack KDE Settings - KDE Plasma defaults package
#
# NOTE: This package does NOT own files in /etc/skel/.config/ to avoid
# file conflicts with zarchblack-plasma-config (which already owns them).
# All KDE config default files live in zarchblack-plasma-config.
# This package exists as a dependency anchor and for documentation.

pkgname=zarchblack-kde-settings
pkgver=1.0.0
pkgrel=2
pkgdesc="ZarchBlack KDE Plasma settings defaults - keyboard, shortcuts, screen lock"
arch=('any')
url="https://github.com/ZarchBlack/zarchblack"
license=('GPL3')
depends=('zarchblack-plasma-config' 'zarchblack-theme')
install=zarchblack-kde-settings.install
source=()
sha256sums=()

package() {
  mkdir -p "${pkgdir}/usr/share/doc/zarchblack-kde-settings"
  echo "ZarchBlack KDE Settings ${pkgver}" > "${pkgdir}/usr/share/doc/zarchblack-kde-settings/README"
}
